 # ── 请求验证 ───────────────────────────────────────────────────────────────
 
+def _callback_guard():
+    """Load the reviewed shared pure validator without changing sys.path."""
+    import importlib.util
+    spec = importlib.util.spec_from_file_location(
+        "_stock_dingtalk_callback_guard", "/root/stock/integrations/dingtalk_guard.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
 def verify_outgoing_token(token: str) -> bool:
-    """验证钉钉 Outgoing 机器人 Token（明文比对模式）"""
