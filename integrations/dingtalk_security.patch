-        logger.warning("DINGTALK_OUTGOING_TOKEN 未配置，跳过验证")
-        return True
-    return hmac.compare_digest(token, config.DINGTALK_OUTGOING_TOKEN)
+    """Legacy Outgoing token mode; missing configuration always rejects."""
+    return _callback_guard().verify_token(token, config.DINGTALK_OUTGOING_TOKEN)
+
+
+def verify_callback_request(headers, now_ms=None):
+    """Explicit legacy-token or enterprise-AppSecret callback authentication."""
+    import os
+    mode = os.environ.get("DINGTALK_CALLBACK_AUTH_MODE", "token")
+    secret = os.environ.get("DINGTALK_CALLBACK_APP_SECRET", "")
+    return _callback_guard().verify_request(
+        headers, mode=mode, token=getattr(config, "DINGTALK_OUTGOING_TOKEN", ""),
+        app_secret=secret, now_ms=now_ms)
+
+
+def parse_callback_body(raw):
+    """Return validated callback JSON and an optional HTTP error status."""
+    return _callback_guard().parse_payload(raw)
 
 
